# Hugging Face Access Token (requis pour les modèles Kiriku et Whisper)
HF_TOKEN="hf_your_token_here"

# WhatsApp Cloud API (requis pour le pipeline webhook : backend/pipeline.py)
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Choisi par vous, à ressaisir tel quel dans la configuration du webhook Meta.
WHATSAPP_VERIFY_TOKEN=""
# Version de la Graph API ciblée (cf. https://developers.facebook.com/docs/graph-api/changelog)
WHATSAPP_API_VERSION="v21.0"

# Chemin de la base SQLite (clients, opérations, confirmations en attente).
# Par défaut : backend/tewlu.db si non renseigné.
DB_PATH=""

# Heure (0-23, fuseau du serveur) d'envoi du bilan vocal automatique du soir.
BILAN_HEURE="21"

# Moteur de compréhension : auto (défaut : kaddu si OPENROUTER_API_KEY est présente, sinon regles),
# kaddu (couche LLM + atlas de Marème, nlp/kaddu.py) ou regles (nlp/extractor.py, sans réseau).
NLU_MOTEUR="auto"
# Clé du LLM utilisé par la couche Kaddu (https://openrouter.ai/keys).
OPENROUTER_API_KEY=""
# Facultatif : modèle LLM (défaut : le premier de nlp/outils/extraire_llm.py MODELES)
# et dossier des conversations Kaddu en cours (défaut : nlp/data/whatsapp, ignoré par Git).
KADDU_MODELE=""
KADDU_DOSSIER=""

# Telegram (repli de WhatsApp) : token donné par @BotFather (/newbot). Si renseigné, le
# serveur reçoit les messages par long polling : pas besoin de ngrok ni d'URL publique.
TELEGRAM_BOT_TOKEN=""
